# Copy to .env.local and fill in values

# ── Public (safe for browser) ────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com  # Use Helius RPC URL for prod
NEXT_PUBLIC_SOLANA_NETWORK=devnet                     # devnet | mainnet-beta — controls homepage status pill
NEXT_PUBLIC_APP_URL=http://localhost:3333             # Full origin — used for SSR arena API calls
NEXT_PUBLIC_SKILL_REGISTRY_PROGRAM_ID=
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_PLATFORM_TREASURY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Private (server-side only — NEVER prefix with NEXT_PUBLIC_) ─────────────
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_FEE_BPS=500
INTERNAL_API_KEY=
PREVIEW_RATE_LIMIT_DAILY=3
SOLANA_PRIVATE_KEY=          # Base58 keypair — platform wallet for x402 skill payments in Chat

# ── AI providers (add keys for each provider you want to support) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ── LLM defaults (platform-wide, not user-configurable) ──────────────────────
LLM_DEFAULT_PROVIDER=openrouter          # anthropic | openai | google | openrouter
LLM_DEFAULT_MODEL=meta-llama/llama-4-maverick  # any model ID valid for the chosen provider

# ── Helius — RPC + Webhooks ───────────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# ── Vercel Cron auth ──────────────────────────────────────────────────────────
CRON_SECRET=                             # Set in Vercel dashboard — secures /api/cron/* endpoints

# ── x402 instant payments ─────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator

# ── Upstash Redis — SSE pub/sub + rate limiting ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Dynamic
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=<from dashboard.dynamic.xyz>
NEXT_PUBLIC_GA_ID=