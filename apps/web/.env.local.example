# Copy to .env.local and fill in values

# ── Public (safe for browser) ────────────────────────────────────────────────
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com  # Use Helius RPC URL for prod
NEXT_PUBLIC_SKILL_REGISTRY_PROGRAM_ID=
NEXT_PUBLIC_ESCROW_PROGRAM_ID=
NEXT_PUBLIC_PLATFORM_TREASURY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Private (server-side only — NEVER prefix with NEXT_PUBLIC_) ─────────────
SUPABASE_SERVICE_ROLE_KEY=
PLATFORM_FEE_BPS=500
INTERNAL_API_KEY=
PREVIEW_RATE_LIMIT_DAILY=3

# ── AI providers (add keys for each provider you want to support) ─────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=

# ── LLM defaults (platform-wide, not user-configurable) ──────────────────────
LLM_DEFAULT_PROVIDER=openrouter          # anthropic | openai | google | openrouter
LLM_DEFAULT_MODEL=meta-llama/llama-4-maverick  # any model ID valid for the chosen provider

# ── Helius — RPC + Webhooks ───────────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_WEBHOOK_SECRET=

# ── x402 instant payments ─────────────────────────────────────────────────────
X402_FACILITATOR_URL=https://x402.org/facilitator

# ── Upstash Redis — SSE pub/sub + rate limiting ───────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
